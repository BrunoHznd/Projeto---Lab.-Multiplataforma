# ========================
# tiResolve - Configuração de Ambiente
# ========================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA suba o .env para o repositório!

# ========================
# Banco de Dados PostgreSQL
# ========================
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# Exemplo local (VPS): postgresql://tiresolve_user:senha_segura@localhost:5432/tiresolve_db
DATABASE_URL=postgresql://tiresolve_user:TROQUE_AQUI@localhost:5432/tiresolve_db

# ========================
# JWT (Autenticação)
# ========================
# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE-PARA-UMA-CHAVE-SECRETA-FORTE

# Tempo de expiração do token (em minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ========================
# Aplicação
# ========================
APP_NAME=tiResolve
DEBUG=False

# CORS - origens permitidas (separar por vírgula)
# Em produção, trocar * pelo domínio real do frontend
# Ex: CORS_ORIGINS=["https://tiresolve.web.app","https://seudominio.com"]
CORS_ORIGINS=["*"]
