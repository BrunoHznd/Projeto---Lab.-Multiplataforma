      "env": {
        "EAS_NO_VCS": "1",
        "TIRESOLVE_API_URL": "http://67.211.211.231/api"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
